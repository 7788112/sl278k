<!DOCTYPE html>
<html lang="zh‑CN">
<head>
<meta charset="utf‑8">
<title>SL278 BLE Bridge Client（带0x04自动模式）</title>
<style>
body{font-family:system-ui;max-width:800px;margin:12px;}
pre{background:#f5f5f5;padding:8px;overflow:auto;font-size:12px;}
</style>
</head>
<body>
<h2>SL278 BLE桥接｜WebBluetooth</h2>
<div>
<button id="connectBtn">连接蓝牙 SL278</button>
<button id="fullStopBtn">全部硬件停止</button>
</div>
<div>
<p>服务端地址：<input id="serverUrl" value="https://mcp.anchordomain.top" style="width:420px;"></p>
<p>状态日志：</p>
<pre id="log"></pre>
</div>

<script>
const SERVER_INPUT = document.getElementById('serverUrl');
const CONNECT_BTN = document.getElementById('connectBtn');
const STOP_BTN = document.getElementById('fullStopBtn');
const LOG_PRE = document.getElementById('log');

let device = null;
let writeChar = null;
let pollTimer = null;
let autoKeepAliveTimer = null;

// 发送帧队列，强制帧间隔60ms
const frameQueue = [];
let queueBusy = false;

function log(txt){
    LOG_PRE.innerText += new Date().toLocaleTimeString() + " " + txt + "\n";
    LOG_PRE.scrollTop = LOG_PRE.scrollHeight;
}

async function sendFrame(buf){
    if(!writeChar){log("未连接BLE，丢弃帧");return;}
    frameQueue.push(buf);
    await drainQueue();
}

async function drainQueue(){
    if(queueBusy) return;
    queueBusy = true;
    while(frameQueue.length>0){
        const f = frameQueue.shift();
        try{
            await writeChar.writeWithoutResponse(f);
            log("TX: "+ Array.from(f).map(x=>x.toString(16).padStart(2,'0')).join(" "));
        }catch(e){
            log("发送失败 "+e.message);
        }
        await sleep(60); //协议强制间隔≥60ms
    }
    queueBusy = false;
}

function sleep(ms){return new Promise(r=>setTimeout(r,ms));}

// 帧生成逻辑（和后端保持一致）
function buildSuckFrame(mode,intensity){
    return new Uint8Array([0x55,0x09,0x00,0x00,mode,intensity,0x00]);
}
function buildVibrateFrame(mode,intensity){
    return new Uint8Array([0x55,0x03,0x00,0x00,mode,intensity,0x00]);
}
function buildAutoFrame(enable,strength){
    if(enable){
        return new Uint8Array([0x55,0x04,0x00,0x00,0x01,strength,0xAA]);
    }else{
        return new Uint8Array([0x55,0x04,0x00,0x00,0x00,0x00,0xAA]);
    }
}
function buildThrustFrame(lv){
    return new Uint8Array([0x55,0x08,0x00,0x00,lv,0x00,0x00]);
}
function buildHeatFrame(on,temp=52){
    if(!on) return new Uint8Array([0x55,0x05,0x00,0x00,0x00,0x00,0x00]);
    return new Uint8Array([0x55,0x05,0x01,temp,0x00,0x00,0x00]);
}

let lastState = null;

// poll轮询后端状态
async function pollServer(){
    const base = SERVER_INPUT.value.trim();
    try{
        const resp = await fetch(base+"/poll");
        const state = await resp.json();
        if(!lastState){
            lastState = JSON.parse(JSON.stringify(state));
            return;
        }
        // 对比状态变更，发送对应硬件帧
        await diffAndSend(lastState, state);
        lastState = JSON.parse(JSON.stringify(state));
    }catch(err){
        log("poll error "+err.message);
    }
}

async function diffAndSend(oldS, newS){
    // 吮吸变化
    if(oldS.suckMode !== newS.suckMode || oldS.suck !== newS.suck){
        await sendFrame(buildSuckFrame(newS.suckMode, newS.suck));
    }
    //普通震动变化
    if(oldS.vibrateMode !== newS.vibrateMode || oldS.vibrate !== newS.vibrate){
        await sendFrame(buildVibrateFrame(newS.vibrateMode, newS.vibrate));
    }
    //自动模式处理：开启则启动1500ms保活定时器；关闭销毁定时器发送停止帧
    if(oldS.autoMode !== newS.autoMode || oldS.autoStrength !== newS.autoStrength){
        if(autoKeepAliveTimer) clearInterval(autoKeepAliveTimer);
        if(newS.autoMode ===1){
            log("autoMode ON，启动1500ms保活");
            await sendFrame(buildAutoFrame(true, newS.autoStrength));
            autoKeepAliveTimer = setInterval(async ()=>{
                await sendFrame(buildAutoFrame(true, newS.autoStrength));
            },1500);
        }else{
            log("autoMode OFF，发送auto停止帧");
            await sendFrame(buildAutoFrame(false,0));
        }
    }
    //伸缩
    if(oldS.thrust !== newS.thrust){
        await sendFrame(buildThrustFrame(newS.thrust));
    }
    //加热
    if(oldS.heat !== newS.heat){
        await sendFrame(buildHeatFrame(!!newS.heat));
    }
}

// 全部停止，调用后端stop接口，拿到全部停止帧序列依次发送
async function fullHardwareStop(){
    log("执行全部硬件停止");
    if(autoKeepAliveTimer){
        clearInterval(autoKeepAliveTimer);
        autoKeepAliveTimer = null;
    }
    const base = SERVER_INPUT.value.trim();
    const res = await fetch(base+"/stop",{method:"POST"});
    const data = await res.json();
    //后端返回hex字符串数组 stop_frames_hex
    for(const hexStr of data.stop_frames_hex){
        const arr = hexStr.split(" ").map(s=>parseInt(s,16));
        await sendFrame(new Uint8Array(arr));
    }
}

// 蓝牙连接
CONNECT_BTN.onclick = async ()=>{
    try{
        log("开始扫描SL278设备");
        device = await navigator.bluetooth.requestDevice({
            filters:[{namePrefix:"SL278"}],
            optionalServices:["ffe0"]
        });
        const gatt = await device.gatt.connect();
        const service = await gatt.getPrimaryService(0xffe0);
        writeChar = await service.getCharacteristic(0xffe1);
        log("BLE已连接 ffe1 write‑without‑response");
        //启动poll
        if(pollTimer) clearInterval(pollTimer);
        pollTimer = setInterval(pollServer,400);
    }catch(e){
        log("连接失败："+e.message);
    }
};

STOP_BTN.onclick = fullHardwareStop;

window.addEventListener('beforeunload',()=>{
    if(autoKeepAliveTimer) clearInterval(autoKeepAliveTimer);
    if(pollTimer) clearInterval(pollTimer);
});
</script>
</body>
</html>