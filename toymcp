from fastapi import FastAPI, Request, Response
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
import time
import json
import asyncio
from typing import Dict, Any, List
from sse_starlette.sse import EventSourceResponse

app = FastAPI()

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

current_command = {
    "vibrateMode": 1,
    "vibrate": 0,
    "suckMode": 0,
    "suck": 0,
    "autoMode": 0,       # 新增：0关闭，1开启0x04自动模式
    "autoStrength": 128, # 0‑255 自动模式强度
    "thrust": 0,
    "heat": 0,
    "timestamp": 0
}
bridge_status = {"last_poll": 0}

class CmdBody(BaseModel):
    vibrateMode: int | None = None
    vibrate: int | None = None
    suckMode: int | None = None
    suck: int | None = None
    autoMode: int | None = None
    autoStrength: int | None = None
    thrust: int | None = None
    heat: int | None = None

# 吮吸 0x09
def build_suck_frame(mode: int, intensity: int) -> bytearray:
    mode = max(0, min(5, mode))
    intensity = max(0, min(10, intensity))
    return bytearray([0x55,0x09,0x00,0x00,mode & 0xFF,intensity & 0xFF,0x00])

# 普通震动 0x03
def build_vibrate_frame(mode:int, intensity:int) -> bytearray:
    return bytearray([0x55,0x03,0x00,0x00,mode &0xFF, intensity&0xFF, 0x00])

# 自动模式 0x04；注意结尾是AA，不是00
def build_auto_frame(enable:bool, strength:int) -> bytearray:
    strength = max(0, min(255, strength))
    if enable:
        return bytearray([0x55,0x04,0x00,0x00,0x01, strength &0xFF, 0xAA])
    else:
        return bytearray([0x55,0x04,0x00,0x00,0x00, 0x00, 0xAA])

# 伸缩 0x08
def build_thrust_frame(level:int) -> bytearray:
    lv = max(0, min(7, level))
    return bytearray([0x55,0x08,0x00,0x00, lv &0xFF, 0x00, 0x00])

# 加热 0x05
def build_heat_frame(on:bool, temp_c:int=52) -> bytearray:
    if not on:
        return bytearray([0x55,0x05,0x00,0x00,0x00,0x00,0x00])
    t = max(40, min(55, temp_c))
    return bytearray([0x55,0x05,0x01, t &0xFF, 0x00,0x00,0x00])

# 全部通道独立停止帧（包含0x04自动模式）
def get_all_stop_frames() -> List[bytearray]:
    return [
        build_vibrate_frame(0,0),
        build_suck_frame(0,0),
        build_auto_frame(False,0),
        build_thrust_frame(0),
        build_heat_frame(False)
    ]

@app.post("/cmd")
def set_cmd(body: CmdBody):
    # vibrateMode：大于0才限制范围，0代表关闭
    if body.vibrateMode is not None:
        current_command["vibrateMode"] = max(1, min(10, body.vibrateMode)) if body.vibrateMode>0 else 1
    if body.vibrate is not None:
        current_command["vibrate"] = max(1, min(10, body.vibrate)) if body.vibrate>0 else 0

    if body.suckMode is not None:
        current_command["suckMode"] = max(1, min(5, body.suckMode)) if body.suckMode>0 else 0
    if body.suck is not None:
        current_command["suck"] = max(1, min(10, body.suck)) if body.suck>0 else 0

    if body.autoMode is not None:
        current_command["autoMode"] = 1 if body.autoMode>0 else 0
    if body.autoStrength is not None:
        current_command["autoStrength"] = max(0, min(255, body.autoStrength))

    if body.thrust is not None:
        current_command["thrust"] = max(1, min(7, body.thrust)) if body.thrust>0 else 0

    if body.heat is not None:
        current_command["heat"] = 1 if body.heat>0 else 0

    current_command["timestamp"] = time.time()
    return {"status": "ok", "cmd": current_command}

@app.get("/poll")
def poll():
    bridge_status["last_poll"] = time.time()
    return current_command

@app.get("/status")
def status():
    alive = (time.time() - bridge_status["last_poll"]) < 10
    return {"bridge_alive": alive, "current": current_command}

@app.post("/stop")
def stop_all():
    current_command["vibrateMode"] = 1
    current_command["vibrate"] = 0
    current_command["suckMode"] = 0
    current_command["suck"] = 0
    current_command["autoMode"] = 0
    current_command["autoStrength"] = 128
    current_command["thrust"] = 0
    current_command["heat"] = 0
    current_command["timestamp"] = time.time()
    stop_hex = [f.hex(" ") for f in get_all_stop_frames()]
    return {"status":"stopped","stop_frames_hex":stop_hex}

@app.get("/debug/sl278h_frames")
def debug_frames(
    vibrateMode:int=3, vibrate:int=5,
    suckMode:int=3, suck:int=6,
    autoStrength:int=128, thrust:int=3, heat:int=1
):
    return {
        "vibrate_frame": build_vibrate_frame(vibrateMode, vibrate).hex(" "),
        "suck_frame": build_suck_frame(suckMode, suck).hex(" "),
        "auto_frame_on": build_auto_frame(True,autoStrength).hex(" "),
        "auto_frame_off": build_auto_frame(False,0).hex(" "),
        "thrust_frame": build_thrust_frame(thrust).hex(" "),
        "heat_frame": build_heat_frame(bool(heat)).hex(" "),
        "stop_frames": [f.hex(" ") for f in get_all_stop_frames()]
    }

