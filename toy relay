sessions: Dict[str, Any] = {}


@app.get("/mcp")
async def mcp_sse(request: Request):
    import uuid
    session_id = str(uuid.uuid4())
    sessions[session_id] = {"queue": []}

    async def event_generator():
        try:
            yield {"event": "endpoint", "data": f"/mcp?sessionId={session_id}"}
            init_msg = {
                "jsonrpc": "2.0",
                "method": "server/info",
                "result": {
                    "name": "sl278k‑bridge‑sse",
                    "version": "1.0.0",
                    "tools": MCP_TOOLS_DEF
                }
            }
            yield {"event": "message", "data": json.dumps(init_msg)}
            while True:
                if await request.is_disconnected():
                    break
                q = sessions[session_id]["queue"]
                while q:
                    item = q.pop(0)
                    yield {"event": "message", "data": json.dumps(item)}
                await asyncio.sleep(0.05)
        finally:
            if session_id in sessions:
                del sessions[session_id]
    return EventSourceResponse(event_generator())


@app.post("/mcp")
async def mcp_post(request: Request, sessionId: str | None = None):
    body = await request.json()
    if not sessionId or sessionId not in sessions:
        return Response(json.dumps({"error": "invalid session"}), status_code=400)

    msg_id = body.get("id")
    method = body.get("method")
    params = body.get("params", {})
    resp = {"jsonrpc": "2.0", "id": msg_id}

    if method == "tools/call":
        tool_name = params["name"]
        args = params.get("arguments", {})
        if tool_name == "set_device_cmd":
            b = CmdBody(**args)
            set_cmd(b)
            resp["result"] = {"content": [{"type": "text", "text": "ok: set_device_cmd executed"}]}
        elif tool_name == "stop_all_device":
            stop_all()
            resp["result"] = {"content": [{"type": "text", "text": "ok: all stopped"}]}
        elif tool_name == "get_device_status":
            data = status()
            resp["result"] = {"content": [{"type": "text", "text": json.dumps(data, ensure_ascii=False)}]}
        else:
            resp["error"] = {"code": -32601, "message": "unknown tool"}
    else:
        resp["result"] = {}

    sessions[sessionId]["queue"].append(resp)
    return {"ok": True}


